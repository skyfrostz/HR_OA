# Copy to a private chmod 0600 file under .local/. Replace empty settings before deployment.
# Use full registry references with an immutable sha256 image digest.
OA_API_IMAGE=
OA_WEB_IMAGE=
OA_WEB_PORT=18080
OA_APP_SUBNET=172.30.65.0/29
OA_PROXY_IP=172.30.65.2

OA_ENV=production
OA_PUBLIC_ORIGIN=
# Go MySQL DSN for the managed database. TLS with certificate verification is required.
OA_MYSQL_DSN=
OA_JWT_SECRET=
OA_BOOTSTRAP_ADMIN_USERNAME=
OA_BOOTSTRAP_ADMIN_PASSWORD=

OA_WECOM_MODE=disabled
OA_WECOM_CORP_ID=
OA_WECOM_SECRET=
OA_WECOM_AGENT_ID=
OA_WECOM_DELIVER_NOTIFICATIONS=false
OA_CONTRACT_REMINDER_SCHEDULE=false
OA_CONTRACT_REMINDER_DAYS=0

OA_OSS_ENABLED=false
OA_OSS_MOCK=false
OA_OSS_REGION=
OA_OSS_BUCKET=
OA_OSS_ENDPOINT=
OA_OSS_PREFIX=hr-oa
OA_OSS_ACCESS_KEY_ID=
OA_OSS_ACCESS_KEY_SECRET=
OA_OSS_SECURITY_TOKEN=
OA_OSS_USE_CNAME=false
OA_ATTACHMENT_WRITE_BACKEND=local
